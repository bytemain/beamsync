{
  "name": "beamsync-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/protocol",
    "packages/coordinator",
    "packages/server",
    "packages/edge-relay",
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run build && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "start:server": "npm --workspace @beamsync/server run start",
    "start:edge-relay": "npm --workspace @beamsync/edge-relay run start",
    "setup:r2-lifecycle": "node scripts/setup-r2-lifecycle.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/ws": "^8.18.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
