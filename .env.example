# Public HTTP/HTTPS entrypoint reachable by clients (e.g. https://sync.yourdomain.com)
PUBLIC_URL=https://sync.yourdomain.com

# Public hostname or IP exposing UDP 3478 for built-in STUN NAT hole punching
PUBLIC_STUN_HOST=sync.yourdomain.com
PORT=8787
STUN_PORT=3478
DATA_DIR=/data

# Optional bearer token. When set, creating a pairing, joining a pairing, and managed
# `/v1/leases` calls all require `Authorization: Bearer <token>`; both CLIs then need
# `--api-token` or `BEAMSYNC_API_TOKEN`. When empty, pairing is open to anyone who can reach the server.
BEAMSYNC_API_TOKEN=

# Concurrent sessions before new pairings are refused with 503 SERVER_BUSY (default 5000)
MAX_SESSIONS=
# Memory in MiB for signaling messages kept for resume, across all sessions (default 512)
MAX_REPLAY_BUFFER_MB=

# Shared HMAC secret between Coordinator (`beamsync-server`) and regional Edge Relays (`beamsync-edge-relay`)
RELAY_AUTH_SECRET=change_me_to_32_byte_random_hex

# Optional static Edge Relays (if not using automatic heartbeat registration):
# Format: region=https://<ip-or-domain>:<port>|stun:<ip>:<port>#sha256=<cert_sha256_hex>
EDGE_RELAYS=

# Cloudflare R2 S3 API binding (leave blank only for local single-node disk testing)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=beamsync-packs
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_REGION=auto
